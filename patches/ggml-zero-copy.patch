+// eightfer: E8_SM_STAGE=G: big async uploads from mapped pinned RAM (the staged residual) are copied by G blocks of 256
+// threads reading over PCIe instead of the copy engine; a few blocks saturate PCIe and barely slow other kernels
+// (experiments/zerocopy)
+static __global__ void k_e8_sm_copy(const uint4 * __restrict__ src, uint4 * __restrict__ dst, size_t n16) {
+    const size_t span = (n16 + gridDim.x - 1) / gridDim.x;
+    const size_t b0 = (size_t) blockIdx.x * span, b1 = min(n16, b0 + span);
+    size_t i = b0 + threadIdx.x;
+    for (; i + 7 * blockDim.x < b1; i += 8 * blockDim.x) {
+        uint4 v[8];
+#pragma unroll
+        for (int u = 0; u < 8; u++) v[u] = __ldcs(src + i + (size_t) u * blockDim.x);
+#pragma unroll
+        for (int u = 0; u < 8; u++) dst[i + (size_t) u * blockDim.x] = v[u];
+    }
+    for (; i < b1; i += blockDim.x) dst[i] = __ldcs(src + i);
+}
+
+static bool ggml_cuda_e8_sm_upload(void * dst, const void * data, size_t size, cudaStream_t stream) {
+    static const int g = getenv("E8_SM_STAGE") ? atoi(getenv("E8_SM_STAGE")) : 0;
+    if (g <= 0 || size < ((size_t) 4 << 20) || size % 16 || ((uintptr_t) dst % 16) || ((uintptr_t) data % 16)) return false;
+    void * src = nullptr;
+    if (cudaHostGetDevicePointer(&src, (void *) data, 0) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    k_e8_sm_copy<<<g, 256, 0, stream>>>((const uint4 *) src, (uint4 *) dst, size / 16);
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
+
 static void ggml_backend_cuda_set_tensor_async(ggml_backend_t backend, ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
     ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
     ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
 
     GGML_ASSERT(buf->buft == ggml_backend_cuda_buffer_type(cuda_ctx->device) && "unsupported buffer type");
 
+    if (ggml_cuda_e8_sm_upload((char *) tensor->data + offset, data, size, cuda_ctx->stream())) return;
+
     CUDA_CHECK(cudaMemcpyAsync((char *) tensor->data + offset, data, size, cudaMemcpyHostToDevice, cuda_ctx->stream()));
 }
 
